# Krishna Kripa Bhagavad Gita Attendance Management
# Production Environment Variables Template

PORT=5000
NODE_ENV=production

# MongoDB Atlas Connection String
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-name>.mongodb.net/krishna_kripa?retryWrites=true&w=majority

# JWT Authentication Secret
JWT_SECRET=your_jwt_secret_key_here

# Administrator Credentials
ADMIN_USERNAME=ANIK
ADMIN_PASSWORD=your_secure_admin_password

# Hugging Face Inference API Token for Qwen Model
HF_TOKEN=hf_your_huggingface_token_here
AI_MODEL=Qwen/Qwen2.5-7B-Instruct
